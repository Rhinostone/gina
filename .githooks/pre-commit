#
# Pre-commit guard: fail-closed defense against local-tool paths (#S5).
#
# Paired with:
#   - .gitignore / .npmignore entries (passive)
#   - prepare_version.js "checkNoLocalLeakage" gate (#S3)
#   - prepack check_no_local_leak.js (#S3)
#   - CI security.yml (#S6)
#
# Pattern must stay in sync with those four locations:
#   (^|/)(CLAUDE\.md|\.claude[a-z]*)

set -eu

matches=$(git diff --cached --name-only --diff-filter=AM | grep -iE '(^|/)(CLAUDE\.md|\.claude[a-z]*)' || true)

if [ -n "$matches" ]; then
    echo "[pre-commit] ERROR: local-tool paths staged for commit:" >&2
    while IFS= read -r line; do
        echo "  - $line" >&2
    done <<EOF
$matches
EOF
    echo "" >&2
    echo "[pre-commit] These paths must never be tracked in git." >&2
    echo "[pre-commit] Unstage with: git restore --staged <path>" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Changie entry validation (llms.txt lesson #66)
#
# Unquoted bodies in .changes/unreleased/*.yaml silently truncate at ` #`
# (YAML comment marker) or break parsing on `:` (mapping-values error). The
# check_changie_entries.js script rejects any staged entry whose body isn't
# single-quoted, double-quoted, or a block scalar.
# ---------------------------------------------------------------------------

changes_files=$(git diff --cached --name-only --diff-filter=AM | grep -E '^\.changes/unreleased/.+\.yaml$' || true)

if [ -n "$changes_files" ]; then
    # xargs -d works on GNU but not BSD — use a loop for portability.
    file_args=""
    while IFS= read -r f; do
        file_args="$file_args \"$f\""
    done <<EOF
$changes_files
EOF
    # shellcheck disable=SC2086  # intentional word-split over quoted args
    if ! eval "node script/check_changie_entries.js $file_args"; then
        exit 1
    fi
fi

exit 0
